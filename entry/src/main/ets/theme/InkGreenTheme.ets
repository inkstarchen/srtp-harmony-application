/**
 * 墨绿色主题配色方案 (Ink Green Theme)
 * 专为 DayNote 项目定制的 UI 排版与色彩设计
 * 
 * 设计理念：
 * - 低饱和绿调中性色：护眼、沉稳、现代感
 * - 高对比主色：清晰、聚焦、交互明确
 * - 符合 WCAG AA 无障碍标准
 */

export const InkGreenTheme = {
  // ==================== 核心主色 ====================
  /** 沉稳墨绿，视觉锚点（按钮、选中态、导航高亮） */
  primary: '#2C5545',
  /** 悬浮/高亮状态 */
  primaryLight: '#3E7A63',
  /** 按压/深态 */
  primaryDark: '#1A3A2D',

  // ==================== 背景色系 ====================
  /** 页面底层背景（极浅绿灰，护眼不刺眼） */
  bgMain: '#F7FAF8',
  /** 卡片/弹窗/输入框/工具栏背景 */
  bgCard: '#FFFFFF',
  /** 次级背景/分组容器/侧边栏/时间选择器 */
  bgSub: '#EBF3EF',

  // ==================== 文字色系 ====================
  /** 标题/正文/列表主内容（近黑墨绿，对比度 >12:1） */
  textPrimary: '#1E3328',
  /** 时间/备注/辅助信息（柔和不抢焦点） */
  textSecondary: '#5C7A6A',
  /** 占位符/禁用状态（低对比度，语义明确） */
  textTertiary: '#8A9F92',
  /** 主色背景上的文字 */
  textOnPrimary: '#FFFFFF',

  // ==================== 装饰与边框 ====================
  /** 分割线/输入框边框/Divider（极淡绿，保持界面干净） */
  border: '#D4E2DA',
  /** 柔和阴影（卡片浮层/导航栏/底部栏） */
  shadow: 'rgba(26, 46, 37, 0.06)',
  /** 遮罩层（弹窗背景/加载层/菜单浮层） */
  overlay: 'rgba(26, 46, 37, 0.4)',

  // ==================== 功能色 ====================
  /** 强调色/链接/高亮/成功态（活跃但不跳脱） */
  accent: '#3A7D5C',
  /** 成功状态 */
  success: '#2C5545',
  /** 警告状态（保持对比，柔和橙） */
  warning: '#D48C28',
  /** 错误状态（柔和红，不刺眼） */
  error: '#C84B4B',
} as const;

// 导出类型定义，方便 IDE 类型提示
export type InkGreenThemeType = typeof InkGreenTheme;
